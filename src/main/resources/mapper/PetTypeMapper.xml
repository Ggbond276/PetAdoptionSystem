<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.kmbeast.mapper.PetTypeMapper">
    <!--新增宠物类型 -->
    <insert id="save">
        INSERT INTO pet_type (id, name)
        VALUES (#{id}, #{name})
    </insert>
    <!--更新宠物类型  -->
    <update id="update">
        UPDATE pet_type
        <set>
            <if test = "name != null and name != ''">
                name = #{name},
            </if>
        </set>
        WHERE id = #{id}
    </update>
    <!--删除宠物类型  -->
    <delete id="deleteById">
        DELETE FROM pet_type
        where id = #{id}
    </delete>
    <!--满足分页条件的数据总项-->
    <select id="queryCount" resultType="integer">
        SELECT COUNT(*)
        FROM pet_type pt
        <where>
            <if test="name != null and name != ''">
                AND pt.name Like concat('%', #{name}, '%')
            </if>
        </where>
    </select>
    <!--满足分页条件的数据总项-->
    <select id="query" resultMap="BaseResultMap" parameterType="com.kmbeast.pojo.dto.PetTypeQueryDto">
        SELECT pt.id, pt.name
        FROM pet_type pt
        <where>
            <if test="name != null and name != ''">
                AND pt.name Like concat('%', #{name}, '%')
            </if>
        </where>
        <if test="current !=null and size != null">
            LIMIT #{current}, #{size}
        </if>
    </select>
    <!--根据名称查询宠物类型-->
    <select id="queryByName" resultMap="BaseResultMap" resultType="com.kmbeast.pojo.entity.PetType">
        SELECT pt.id, pt.name
        FROM pet_type pt
        <where>
            <if test="name != null and name != ''">
                AND pt.name = #{name}
            </if>
        </where>
    </select>
    <!--根据id查询宠物类型-->
    <select id="queryById" resultMap="BaseResultMap" resultType="com.kmbeast.pojo.entity.PetType">
        SELECT pt.id, pt.name
        FROM pet_type pt
        <where>
            <if test="id != null">
                AND pt.id = #{id}
            </if>
        </where>
    </select>
    <!--结果映射-->
    <resultMap id="BaseResultMap" type="com.kmbeast.pojo.entity.PetType">
        <id column="id" property="id" />
        <result column="name" property="name" />
    </resultMap>
</mapper>